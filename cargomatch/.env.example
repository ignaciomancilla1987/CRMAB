# CargoMatch - variables de entorno
# Copiar a .env y ajustar

# Entorno
ENV=development
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cargomatch
POSTGRES_USER=cargomatch
POSTGRES_PASSWORD=cargomatch_dev
DATABASE_URL=postgresql+psycopg://cargomatch:cargomatch_dev@localhost:5432/cargomatch

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_admin_dev
S3_BUCKET_EVIDENCIAS=cargomatch-evidencias
S3_BUCKET_DTES=cargomatch-dtes
S3_REGION=us-east-1

# SII (Servicio de Impuestos Internos - Chile)
SII_ENVIRONMENT=certificacion
SII_RUT_EMISOR=
SII_CERT_PATH=

# Integración ERP
ERP_TYPE=mock
ERP_BASE_URL=
ERP_API_KEY=

# LPR / ANPR
LPR_CAMERA_URL=
LPR_WEBHOOK_TOKEN=

# Báscula
SCALE_HOST=
SCALE_PORT=502
SCALE_PROTOCOL=modbus_tcp

# Tolerancias por defecto
DEFAULT_TOLERANCE_QTY_PCT=2.0
DEFAULT_TOLERANCE_WEIGHT_PCT=1.5

# Seguridad
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
